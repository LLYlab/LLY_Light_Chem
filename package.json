  "homepage": "https://llylab.github.io/LLY_Light_Chem/",
  "repository": {
    "type": "git",
    "url": "https://github.com/LLYlab/LLY_Light_Chem.git"
  },
  "keywords": [
    "spectrometer",
    "spectroscopy",
    "physics-lab",
    "wavelength-calibration",
    "grating",
    "image-processing",
    "education",
    "pwa",
    "offline"
  ],
  "scripts": {
    "test": "node --test tests/core.test.mjs",
    "check": "node tools/check_web.mjs",
    "serve": "node tools/serve.mjs",
